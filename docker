version: '3.8'

services:
  postgres:
    image: postgres:16-alpine
    container_name: pro-ai-postgres
    restart: always
    environment:
      POSTGRES_DB: proai
      POSTGRES_USER: proai
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-proai_password}
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/schema.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
      - ./database/init-proai.sql:/docker-entrypoint-initdb.d/02-init-proai.sql:ro
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U proai -d proai"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - pro-ai-network
    deploy:
      resources:
        limits:
          memory: 4g
          cpus: '2'

  redis:
    image: redis:7-alpine
    container_name: pro-ai-redis
    restart: always
    command: redis-server --requirepass ${REDIS_PASSWORD:-redis_password} --maxmemory 512mb --maxmemory-policy allkeys-lru
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD:-redis_password}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    networks:
      - pro-ai-network
    deploy:
      resources:
        limits:
          memory: 1g
          cpus: '0.5'

  ai-engine:
    image: ollama/ollama:latest
    container_name: pro-ai-ollama
    restart: always
    expose:
      - "11434"
    volumes:
      - ollama_data:/root/.ollama
    environment:
      - OLLAMA_HOST=0.0.0.0
      - OLLAMA_ORIGINS=*
      - OLLAMA_MAX_LOADED_MODELS=1
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
        limits:
          memory: 24g
          cpus: '8'
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:11434/api/tags"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
    networks:
      - pro-ai-network
    entrypoint: >
      sh -c "ollama serve &
             sleep 10 &&
             ollama pull llama3.1 &&
             ollama pull qwen2.5 &&
             ollama pull deepseek-r1 &&
             wait"

  backend:
    build:
      context: .
      dockerfile: backend/Dockerfile
    container_name: pro-ai-backend
    restart: always
    environment:
      - DATABASE_URL=postgresql+asyncpg://proai:${POSTGRES_PASSWORD:-proai_password}@postgres:5432/proai
      - REDIS_URL=redis://:${REDIS_PASSWORD:-redis_password}@redis:6379/0
      - SECRET_KEY=${SECRET_KEY:-change-this-to-a-secure-random-key-at-least-32-characters}
      - JWT_SECRET=${JWT_SECRET:-change-this-jwt-secret-key-must-be-at-least-32-characters}
      - ENCRYPTION_KEY=${ENCRYPTION_KEY:-change-this-32-byte-hex-key-for-aes-256-gcm}
      - OLLAMA_BASE_URL=http://ai-engine:11434
      - ENVIRONMENT=production
      - OWNER_EMAIL=${OWNER_EMAIL:-owner@professionalai.com}
      - OWNER_SETUP_KEY=${OWNER_SETUP_KEY:-change-this-owner-setup-key}
      - CORS_ORIGINS=https://professionalai.com,http://localhost:3000
      - FRONTEND_URL=https://professionalai.com
    volumes:
      - backend_logs:/app/logs
      - backend_uploads:/app/uploads
    ports:
      - "8000:8000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      ai-engine:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    networks:
      - pro-ai-network
    deploy:
      resources:
        limits:
          memory: 4g
          cpus: '2'

  # frontend service removed - backend serves frontend static files on port 8000

volumes:
  postgres_data:
  redis_data:
  ollama_data:
  backend_logs:
  backend_uploads:

networks:
  pro-ai-network:
    driver: bridge