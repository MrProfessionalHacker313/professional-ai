# ===================================================================
# PROFESSIONAL AI - ROOT ENVIRONMENT CONFIGURATION
# ===================================================================
# Copy this file to .env and fill in your values.
# This file is loaded by both frontend and backend scripts.
# NEVER commit .env to version control.

# ===================================================================
# DATABASE (PostgreSQL 16 — required)
# ===================================================================
# Local dev (Docker): postgresql+asyncpg://proai:proai_password@localhost:5432/professional_ai
# Docker Compose:    postgresql+asyncpg://proai:${DB_PASSWORD}@postgres:5432/professional_ai
DATABASE_URL=postgresql+asyncpg://proai:proai_password@localhost:5432/professional_ai
DATABASE_URL_SYNC=postgresql+psycopg2://proai:proai_password@localhost:5432/professional_ai
DB_SSL_MODE=prefer
DB_PASSWORD=proai_password
POSTGRES_PASSWORD=proai_password

# ===================================================================
# REDIS
# ===================================================================
# Default: local Redis (optional, falls back to in-memory if not available)
REDIS_URL=redis://localhost:6379/0

# ===================================================================
# SECURITY KEYS (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# WARNING: In production, these MUST be set to secure random values.
# ===================================================================
SECRET_KEY=change-this-to-a-secure-random-key-at-least-32-characters
JWT_SECRET=change-this-jwt-secret-key-must-be-at-least-32-characters
ENCRYPTION_KEY=change-this-32-byte-hex-key-for-aes-256-gcm
METRICS_PASSWORD=change-this-metrics-password-min-16-chars

# ===================================================================
# APPLICATION
# ===================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_VERSION=1.0.0
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS Settings (comma-separated domains - NEVER use * in production)
CORS_ORIGINS=https://professionalai.com,http://localhost:3000

# ===================================================================
# SECURITY & AUTHENTICATION HARDENING
# ===================================================================
# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=professional-ai
JWT_AUDIENCE=professional-ai-frontend

# Account Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Sessions & Cookies
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
CSRF_TOKEN_TTL_SECONDS=3600
DEVICE_FINGERPRINT_REQUIRED=true

# Feature Toggles
ENABLE_2FA_ENFORCEMENT=false
ENABLE_PASSKEYS=true
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_LOGIN_ALERTS=true
ENABLE_ACCOUNT_LOCKOUT=true
ENABLE_AUDIT_LOGGING=true
ENABLE_AUTO_SECURITY_SCAN=true
ENABLE_WAF=true
ENABLE_CSP=true
ENABLE_HSTS=true
EMAIL_VERIFICATION_REQUIRED=true

# ===================================================================
# RATE LIMITING (per minute)
# ===================================================================
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_ADMIN=10/minute
RATE_LIMIT_AI=20/minute

# ===================================================================
# FILE UPLOAD SECURITY
# ===================================================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.png,.jpg,.jpeg,.gif

# ===================================================================
# SECURITY MONITORING & ALERTS
# ===================================================================
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=noreply@professionalai.com
ALERT_ON_BRUTE_FORCE=true
ALERT_ON_MASS_DATA_ACCESS=true
ALERT_ON_SUSPICIOUS_LOGIN=true
MASS_DATA_ACCESS_THRESHOLD=1000
SUSPICIOUS_LOGIN_THRESHOLD_KM=500
SECURITY_SCAN_INTERVAL_HOURS=24

# ===================================================================
# BACKUP ENCRYPTION
# ===================================================================
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=

# ===================================================================
# UNLIMITED MODE - Paid users get unlimited code/chat/languages
# ===================================================================
# Active PRO/MAX/BUSINESS/ENTERPRISE users get UNLIMITED code generation,
# unlimited chat, unlimited languages, and priority speed routing.
# Free users keep: 3 code prompts/day + 50 chats/day.
# Canceled/downgraded users are limited immediately.
UNLIMITED_MODE_ENABLED=true
# Plans that get unlimited access (comma-separated)
UNLIMITED_PLANS=pro,pro_yearly,max,business,enterprise,trial
# Free plan limits (unchanged)
FREE_CODE_LIMIT_PER_DAY=3
FREE_CHAT_LIMIT_PER_DAY=50
# Accuracy double-check (cross-verify between two providers)
ACCURACY_DOUBLE_CHECK_ENABLED=true
# Priority provider order for paid users (fastest first)
PRIORITY_PROVIDER_ORDER=groq,gemini,openrouter,ollama,local

# ===================================================================
# AI ENGINE (LIGHT MODE) - Cloud Free Tiers, No Local Models
# ===================================================================
# Provider chain (AI_PROVIDER=auto):
#   1. Gemini  (gemini-2.5-flash for chat, gemini-2.5-pro for hard code)
#   2. Groq    (llama-3.3-70b-versatile for general + code)
#   3. OpenRouter (deepseek / qwen2.5-coder-32b free models)
# If one fails/rate-limits/times out → auto-switch to next.
# If ALL fail → "AI engine busy, try again" with retry button.
AI_PROVIDER=auto

# Ollama is DISABLED by default. Set to true ONLY on a strong server/machine
# where you want it as a final fallback. On a normal PC it stays off (zero RAM).
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# First provider must respond within this many seconds before failover.
AI_TIMEOUT_SECONDS=3.0
# Additional time allowed for failover providers.
AI_FAILOVER_TIMEOUT_SECONDS=2.0
# Cache repeated questions locally for this many seconds.
AI_CACHE_TTL_SECONDS=3600
# Max tokens for chat responses.
AI_MAX_TOKENS_CHAT=2048
# Max tokens for code generation.
AI_MAX_TOKENS_CODE=8192

# ===================================================================
# AI API KEYS (FREE TIERS) - PERMANENT API VAULT
# ===================================================================
# 1. GEMINI (Google AI Studio - free tier)
#    Create key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. GROQ (free tier, very fast)
#    Create key at: https://console.groq.com/keys
GROQ_API_KEY=

# 3. OPENROUTER (optional - free models: deepseek, qwen2.5-coder-32b)
#    Create key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional paid providers (not required for light mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===================================================================
# PERMANENT API VAULT - MULTI-KEY SUPPORT (NEVER RUN OUT)
# Add unlimited keys per provider, comma-separated.
# System uses key1; when rate-limited, switches to key2, key3, then next provider.
# No code change needed. Just add keys, restart, done.
# ===================================================================
GEMINI_KEYS=
GROQ_KEYS=
OPENROUTER_KEYS=

# ===================================================================
# MEDIA API VAULT - Images, Video, Animation, Voice
# Multi-key rotation + auto-failover. Never expire, never hang.
# ===================================================================
# fal.ai (SDXL + Flux) — primary image engine
FAL_AI_API_KEY=
FAL_KEYS=
# Replicate — backup image + AnimateDiff backup
REPLICATE_API_KEY=
REPLICATE_KEYS=
# Kling AI — primary video engine
KLING_API_KEY=
KLING_KEYS=
# Runway ML — video backup
RUNWAY_API_KEY=
RUNWAY_KEYS=
# ElevenLabs — primary TTS engine
ELEVENLABS_API_KEY=
ELEVENLABS_KEYS=
# AnimateDiff — Replicate backup only (primary = ComfyUI on GPU server)
ANIMATEDIFF_API_KEY=
ANIMATEDIFF_API_URL=https://api.replicate.com/v1
ANIMATEDIFF_MODEL=guoyingzheng/animatediff

# Media external call timeout (seconds) — max before failover
MEDIA_EXTERNAL_TIMEOUT_SECONDS=10

# GPU Server (owner's ComfyUI on NVIDIA T4/A100)
COMFYUI_URL=http://localhost:8188

# Google Cloud Storage (uploads on owner's server)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Internal worker secret (Node.js BullMQ worker → backend callbacks)
INTERNAL_WORKER_SECRET=change-this-to-a-secure-random-string

# ===================================================================
# PERMANENT API VAULT - LOCAL ONNX FALLBACK (LAYER 4 - NEVER STOPS)
# Runs on-device. ZERO cost, ZERO expiry, no internet needed.
# Guarantees the AI ALWAYS answers no matter what.
# ===================================================================
LOCAL_FALLBACK_ENABLED=true
LOCAL_MODELS_DIR=./data/local_models
LOCAL_CHAT_MODEL=qwen2.5-0.5b-instruct
LOCAL_CODE_MODEL=qwen2.5-coder-1.5b

# ===================================================================
# PERMANENT API VAULT - ROUTING & RESILIENCE
# ===================================================================
# Per-provider timeout before failover (seconds).
VAULT_TIMEOUT_SECONDS=2.0
# Max time a request waits in the queue during a momentary outage.
VAULT_QUEUE_MAX_SECONDS=5.0
# Health monitor ping interval (seconds).
VAULT_HEALTH_CHECK_INTERVAL_SECONDS=60
# Log all API calls (provider, latency, cost) to the owner dashboard.
VAULT_LOG_ENABLED=true
# Monthly key refresh reminder (days between reminders).
VAULT_KEY_REFRESH_REMINDER_DAYS=30

# ===================================================================
# AI SERVICE URLS (Self-hosted - only used if OLLAMA_ENABLED=true)
# ===================================================================
COMFYUI_URL=http://localhost:8188
WHISPER_API_URL=http://localhost:8001
TTS_API_URL=http://localhost:8002
SEARXNG_URL=http://localhost:8888

# ===================================================================
# GOOGLE CLOUD
# ===================================================================
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ===================================================================
# MONITORING
# ===================================================================
GRAFANA_PASSWORD=admin
METRICS_AUTH_ENABLED=true
METRICS_USERNAME=metrics

# ===================================================================
# PAYMENT GATEWAYS (Optional)
# ===================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_GATEWAY_ACTIVE=true
STRIPE_PAYOUT_CURRENCY=USD
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_GATEWAY_ACTIVE=true
WISE_API_KEY=
WISE_GATEWAY_ACTIVE=true
WISE_AUTO_SETTLEMENT_TO_ALLIED=true
PAYONEER_API_KEY=
PAYONEER_GATEWAY_ACTIVE=true
PAYONEER_AUTO_SETTLEMENT_TO_ALLIED=true
SKRILL_API_KEY=
SKRILL_GATEWAY_ACTIVE=true
SKRILL_AUTO_SETTLEMENT_TO_ALLIED=true
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
BINANCE_PAY_GATEWAY_ACTIVE=true
JAZZCASH_MERCHANT_ID=
JAZZCASH_SECRET_KEY=
JAZZCASH_GATEWAY_ACTIVE=true
EASYPAISA_MERCHANT_ID=
EASYPAISA_SECRET_KEY=
EASYPAISA_GATEWAY_ACTIVE=true
SADAPAY_SECRET_KEY=
SADAPAY_GATEWAY_ACTIVE=true
NAYAPAY_SECRET_KEY=
NAYAPAY_GATEWAY_ACTIVE=true
ALLIED_BANK_ACCOUNT_NAME=
ALLIED_BANK_ACCOUNT_NUMBER=
ALLIED_BANK_IBAN=
ALLIED_BANK_SWIFT=
ALLIED_BANK_BRANCH=
ALLOWED_COUNTRIES=ALL
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest
EXCHANGE_RATE_API_KEY=

# ===================================================================
# EMAIL / SMS
# ===================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@professionalai.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===================================================================
# SENTRY (Optional)
# ===================================================================
SENTRY_DSN=

# ===================================================================
# OWNER SUPREME MODE
# ===================================================================
OWNER_EMAIL=
OWNER_SETUP_KEY=
OWNER_ENFORCE_PASSKEY=true
OWNER_ENFORCE_TOTP=true
