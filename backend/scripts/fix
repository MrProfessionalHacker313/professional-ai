"""Update voice_style pattern in media.py to include all 14 voices."""
import re

filepath = 'backend/app/routes/media.py'
with open(filepath, 'r', encoding='utf-8') as f:
    content = f.read()

# Build voices list using chr(124) for pipe character
p = chr(124)  # pipe character
voices = p.join([
    'young_girl', 'young_boy', 'adult_male', 'adult_female',
    'news_anchor', 'teacher', 'robot', 'cartoon', 'villain', 'hero',
    'whisper', 'angry', 'happy', 'sad', 'excited', 'robotic',
    'custom', 'clone'
])
new_pattern_str = '^(?:' + voices + ')$'
new_line = 'voice_style: str = Field(default="adult_female", pattern="' + new_pattern_str + '")'

# Split into lines and replace the voice_style line
lines = content.split('\n')
updated = False
for i, line in enumerate(lines):
    if 'voice_style' in line and 'pattern' in line and 'Field' in line:
        lines[i] = new_line
        updated = True
        print(f'Replaced line {i+1}')
        break

if updated:
    with open(filepath, 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))
    print('SUCCESS: voice_style pattern updated with 14 voices')
else:
    print('ERROR: voice_style line not found')