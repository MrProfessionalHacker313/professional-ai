# ===================================================================
# PROFESSIONAL AI - PERMANENT API VAULT KEY MANAGEMENT
# ===================================================================
# Copy this file to .env and fill in your keys.
# The system NEVER runs out of keys — add unlimited keys per provider.
# No code change needed. Just add keys, restart, done.
#
# HOW IT WORKS:
#   Layer 1: Gemini  (free tier) — uses key1, then key2, key3... on rate-limit
#   Layer 2: Groq    (free tier) — uses key1, then key2, key3... on rate-limit
#   Layer 3: OpenRouter (free models) — uses key1, then key2, key3... on rate-limit
#   Layer 4: Local ONNX / knowledge engine — ALWAYS available, ZERO cost, NEVER expires
#
# If ALL keys for a provider are rate-limited, the system automatically
# moves to the next provider. If ALL cloud providers fail, the local
# on-device AI answers. The user NEVER sees an error.
# ===================================================================

# ===================================================================
# LAYER 1: GEMINI (Google AI Studio - free tier)
# Get free keys at: https://aistudio.google.com/apikey
# Add as many as you want, comma-separated. System rotates on rate-limit.
# ===================================================================
GEMINI_API_KEY=your-primary-gemini-key
GEMINI_KEYS=key1,key2,key3,key4,key5

# ===================================================================
# LAYER 2: GROQ (free tier, very fast)
# Get free keys at: https://console.groq.com/keys
# Add as many as you want, comma-separated. System rotates on rate-limit.
# ===================================================================
GROQ_API_KEY=your-primary-groq-key
GROQ_KEYS=key1,key2,key3

# ===================================================================
# LAYER 3: OPENROUTER (free models: deepseek, qwen2.5-coder)
# Get free keys at: https://openrouter.ai/keys
# Add as many as you want, comma-separated. System rotates on rate-limit.
# ===================================================================
OPENROUTER_API_KEY=your-primary-openrouter-key
OPENROUTER_KEYS=key1,key2,key3,key4

# ===================================================================
# LAYER 4: LOCAL ONNX FALLBACK (NEVER STOPS - ZERO COST)
# Runs on-device. No internet needed. No expiry. Guarantees AI always answers.
# ===================================================================
LOCAL_FALLBACK_ENABLED=true
LOCAL_MODELS_DIR=./data/local_models
LOCAL_CHAT_MODEL=qwen2.5-0.5b-instruct
LOCAL_CODE_MODEL=qwen2.5-coder-1.5b

# ===================================================================
# ROUTING & RESILIENCE
# ===================================================================
# Per-provider timeout before failover (seconds).
VAULT_TIMEOUT_SECONDS=2.0
# Max time a request waits in the queue during a momentary outage.
VAULT_QUEUE_MAX_SECONDS=5.0
# Health monitor ping interval (seconds).
VAULT_HEALTH_CHECK_INTERVAL_SECONDS=60
# Log all API calls (provider, latency, cost) to the owner dashboard.
VAULT_LOG_ENABLED=true
# Monthly key refresh reminder (days between reminders).
VAULT_KEY_REFRESH_REMINDER_DAYS=30

# ===================================================================
# MONTHLY KEY REFRESH REMINDER
# ===================================================================
# The owner dashboard shows a one-click reminder every 30 days:
#   "Add free keys at aistudio.google.com / console.groq.com"
# This keeps quota topped up forever at zero cost.
# Just add new keys to GEMINI_KEYS / GROQ_KEYS / OPENROUTER_KEYS
# and restart the server. No code change needed.
# ===================================================================